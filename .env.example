# Pick OPENAI, GEMINI, MINIMAX, or a custom connection name.
# Keep multiple keys here and change these names to switch.
AI_CHAT_PROVIDER=OPENAI
# Leave empty to use the chat connection for drafts.
AI_DRAFT_PROVIDER=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

MINIMAX_API_KEY=
MINIMAX_CHAT_MODEL=MiniMax-M3.1-Flash

# Choose CUSTOM above to use this example connection.
# Enter the base URL of a Chat Completions-compatible API, without /chat/completions.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_CHAT_MODEL=
